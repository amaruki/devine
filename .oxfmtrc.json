{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "sortPackageJson": true,
  "sortTailwindcss": true,
  "ignorePatterns": [
    ".next/**",
    "node_modules/**",
    "coverage/**",
    "playwright-report/**",
    "bun.lock"
  ]
}
